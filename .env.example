# n8n & API Configuration Environment Variables

# n8n Instance Configuration
N8N_HOST=localhost
N8N_PORT=xxxx
N8N_PROTOCOL=http

# Tavily AI Search API
TAVILY_API_KEY=tvly-dev-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenAI API (LangChain LLM & DALL-E 3)
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Google Cloud OAuth (Google Sheets API)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxx
# LinkedIn OAuth API Credentials
LINKEDIN_CLIENT_ID=xxxxxxxxxxxxxxxx
LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxxxxxx
